# Multi-stage build: the builder pulls dependencies; the runtime image copies
# only the resulting venv, keeping it slim and free of build tooling.

# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

RUN pip install uv

WORKDIR /app

# Copy manifests before code so the dependency layer is cached across code edits.
COPY pyproject.toml uv.lock ./

# --no-dev drops test/lint tooling; --frozen pins to uv.lock for reproducibility.
RUN uv sync --no-dev --frozen

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

# curl is used by the HEALTHCHECK below.
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Run as a non-root user to limit blast radius.
RUN groupadd --gid 1001 appuser && \
    useradd --uid 1001 --gid appuser --shell /bin/bash --create-home appuser

WORKDIR /app

# Copy only the venv and the app package — no build tools, tests, or infra.
COPY --from=builder /app/.venv /app/.venv
COPY app/ /app/app/

ENV PATH="/app/.venv/bin:$PATH"
# Unbuffered stdout for real-time logs; no .pyc files in an ephemeral container.
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Create /app/data before the volume mounts here so it inherits appuser
# ownership; otherwise Docker creates the mountpoint as root and the non-root
# process cannot open the SQLite file.
RUN mkdir -p /app/data && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Gates docker-compose's `depends_on: service_healthy`. start-period covers
# uvicorn startup, the Redis connection, and SQLite schema creation.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Two uvicorn workers per container; scale further with more pods, not workers.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "2"]
