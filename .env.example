# Copy to .env and adjust as needed. Never commit .env.
#
# The defaults below run the whole system on a self-hosted Ollama model with no
# API key and no paid service. Set LLM_PROVIDER=anthropic to use Claude instead.

# ── LLM backend ──────────────────────────────────────────────────────────────
# "ollama" (default, self-hosted, free) or "anthropic" (Claude, needs a key).
LLM_PROVIDER=ollama
LLM_MAX_TOKENS=4096

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Anthropic (used when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001

# ── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./resume_tailor.db

# ── Security (change these before any real deployment) ───────────────────────
API_KEY_SALT=change-me-to-a-random-32-char-string
SECRET_KEY=change-me-to-another-random-32-char-string

# ── Runtime ──────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
ENVIRONMENT=development
LOG_LEVEL=INFO
