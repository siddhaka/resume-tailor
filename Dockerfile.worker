# Multi-stage build — same shape as Dockerfile.api (builder + slim runtime).

# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

RUN pip install uv

WORKDIR /app

COPY pyproject.toml uv.lock ./

RUN uv sync --no-dev --frozen

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

RUN groupadd --gid 1001 appuser && \
    useradd --uid 1001 --gid appuser --shell /bin/bash --create-home appuser

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY app/ /app/app/

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

RUN chown -R appuser:appuser /app
USER appuser

# No port: the worker only talks to Redis (broker in, results out).

# Longer start-period than the API: the worker must connect to the broker,
# register task modules, and spin up its pool before `inspect ping` responds.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD celery -A app.worker.celery_app.celery_app inspect ping || exit 1

# Two child processes handle two concurrent (I/O-bound) LLM calls; scale
# throughput with more pods, not higher concurrency, for predictable memory.
CMD ["celery", \
     "-A", "app.worker.celery_app.celery_app", \
     "worker", \
     "--loglevel=info", \
     "--concurrency=2", \
     "--queues=celery"]
