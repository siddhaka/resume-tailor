# Single-stage: the client's only deps (gradio, httpx) need no build tooling,
# so a multi-stage build would save nothing.
FROM python:3.11-slim

RUN pip install --no-cache-dir gradio httpx

WORKDIR /app

COPY app.py .

# Non-root user to limit blast radius.
RUN useradd --uid 1001 --create-home appuser
USER appuser

EXPOSE 7860

CMD ["python", "app.py"]
